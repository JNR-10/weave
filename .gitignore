# --- Experiment output ---
# Directory structure is tracked via .gitkeep; raw runs are not.
results/**/*.json
results/**/*.csv
results/**/*.jsonl
results/**/*.parquet
results/**/*.log
logs/
*.log

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Microsoft Office lock files ---
~$*

