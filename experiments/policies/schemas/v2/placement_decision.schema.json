{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "simulation": {
      "const": true
    },
    "policy": {
      "enum": [
        "best_single_device",
        "equal_split",
        "memory_proportional"
      ]
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chosen_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "NO_FEASIBLE_PLAN"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "executable": {
      "const": false
    },
    "runtime_verified": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "simulation",
    "policy",
    "source_snapshot_id",
    "candidate_set_sha256",
    "chosen_plan_id",
    "outcome",
    "reason",
    "rejection_reasons",
    "executable",
    "runtime_verified"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NO_FEASIBLE_PLAN"
          }
        }
      },
      "then": {
        "properties": {
          "chosen_plan_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "chosen_plan_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}